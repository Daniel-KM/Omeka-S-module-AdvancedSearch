#: view/common/advanced-search/has-media-radio.phtml:24
#: view/common/advanced-search/has-asset.phtml:19
#: view/common/advanced-search/has-original.phtml:19
#: view/common/advanced-search/visibility-radio.phtml:24
msgid "Any"
msgstr "Forzh peseurt"

#: view/common/advanced-search/has-asset.phtml:13
msgid "Use an asset as thumbnail"
msgstr "Ober gant ur benveg evel bihantres"

#: view/common/advanced-search/has-asset.phtml:16
msgid "Has asset"
msgstr "Ennañ ur madoù"

#: view/common/advanced-search/has-asset.phtml:17
msgid "Has no asset"
msgstr "N'en deus madoù ebet"

#: view/common/advanced-search/has-original.phtml:13
msgid "Presence of original file"
msgstr "Bezañs ar restr orin"

#: view/common/advanced-search/has-original.phtml:16
#: config/module.config.php:690
msgid "Has original file"
msgstr "Gant ar restr orin"

#: view/common/advanced-search/has-original.phtml:17
