msgstr ""
"Le format de la requête dépend du formulaire de recherche et du moteur de "
"recherche."

#: src/Form/Admin/SearchConfigConfigureForm.php:222
msgid "Complementary default query"
msgstr "Requête complémentaire par défaut"

#: src/Form/Admin/SearchConfigConfigureForm.php:223
