#: view/advanced-search/admin/search-engine/index-confirm.phtml:61
msgid ""
"Warning: this core is shared (multi-index). This option clears all indexes, "
"included indexes managed externally, not only the ones of this search engine."
msgstr ""
"Attention : ce cœur est partagé (multi-index). Cette option efface tous les "
"index, y compris ceux gérés en dehors d’Omeka."

