<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \AdvancedSearch\Api\Representation\SearchConfigRepresentation $searchConfig
 * @var \AdvancedSearch\Form\Admin\SearchConfigConfigureForm $form
 */

$plugins = $this->getHelperPluginManager();
$translate = $plugins->get('translate');
$assetUrl = $plugins->get('assetUrl');

$this->headLink()
    ->appendStylesheet($assetUrl('css/common-dialog-admin.css', 'Common'));
$this->headScript()
    ->appendFile($assetUrl('js/common-dialog.js', 'Common'), 'text/javascript', ['defer' => 'defer']);
$this->headLink()
    ->appendStylesheet($assetUrl('css/advanced-search-manager.css', 'AdvancedSearch'));
$this->headScript()
    ->appendFile($assetUrl('js/advanced-search-manager.js', 'AdvancedSearch'), 'text/javascript', ['defer' => 'defer'])
    ->appendFile($assetUrl('js/advanced-search-input-preview.js', 'AdvancedSearch'), 'text/javascript', ['defer' => 'defer'])
    ->appendFile($assetUrl('js/advanced-search-collection.js', 'AdvancedSearch'), 'text/javascript', ['defer' => 'defer']);

$this->htmlElement('body')->appendAttribute('class', 'search-admin search-config resource edit');

if (empty($form)) {
    echo $this->pageTitle(sprintf($translate('Search page "%1$s" (%2$s)'), $searchConfig->name(), $searchConfig->slug()), 1, $translate('Search manager'));
    return;
}

$this->headScript()->appendScript(sprintf(
    'window.AdvancedSearch = window.AdvancedSearch || {}; window.AdvancedSearch.collection = %s;',
    json_encode([
        'empty' => $translate('No item yet: use the button + to add one.'),
        'newItem' => $translate('New item'),
        'advanced' => $translate('Advanced settings'),
        'add' => $translate('Add'),
        'remove' => $translate('Remove'),
        'up' => $translate('Move up'),
        'down' => $translate('Move down'),
        'drag' => $translate('Drag to reorder'),
        'general' => $translate('General'),
        'list' => $translate('List'),
        'headerFooter' => $translate('Infos and actions'),
        'resourceCard' => $translate('Display of a result'),
        'technical' => $translate('Technical'),
        'previewResults' => $translate('Preview'),
    ], JSON_UNESCAPED_UNICODE)
));
$this->headScript()->appendScript(sprintf(
    'window.AdvancedSearch.preview = %s;',
    json_encode([
        'preview' => $translate('Preview'),
        'label' => $translate('Label'),
        'value1' => $translate('First value'),
        'value2' => $translate('Second value'),
        'value3' => $translate('Third value'),
        'choose' => $translate('Choose…'),
        'group' => $translate('Group'),
        'anyField' => $translate('Any field'),
        'title' => $translate('Title'),
        'subject' => $translate('Subject'),
        'opContains' => $translate('contains'),
        'opIs' => $translate('is exactly'),
        'queryText' => $translate('Text to search'),
        'and' => $translate('and'),
        'or' => $translate('or'),
        'hidden' => $translate('Hidden field: nothing is displayed, the value is sent with the query.'),
        'multiText' => $translate('first value, second value'),
        'specific' => $translate('Specific type set in the options: no preview.'),
        'accessFree' => $translate('Free'),
        'accessReserved' => $translate('Reserved'),
        'accessForbidden' => $translate('Forbidden'),
        'filterValues' => $translate('Filter the values…'),
        'from' => $translate('From'),
        'to' => $translate('To'),
        'not' => $translate('not'),
        'typed' => $translate('Val'),
        'seeMore' => $translate('See more'),
        'results12' => $translate('12 results'),
        'sortRelevance' => $translate('Relevance'),
        'resultTitle' => $translate('Title of the resource'),
        'resultDescription' => $translate('Description of the resource, on a few lines…'),
        'applyFacets' => $translate('Apply facets'),
        'resetFacets' => $translate('Reset facets'),
        'facetsTitle' => $translate('Facets'),
        'refineSearch' => $translate('Refine search'),
        'quickFilterTitle' => $translate('Quick filter'),
        'resetFields' => $translate('Reset fields'),
        'home' => $translate('Home'),
        'searchTitle' => $translate('Search'),
    ], JSON_UNESCAPED_UNICODE)
));

$form->prepare();

$navTab = [];
foreach ($form->getFieldsets() as $fieldset) {
    $navTab[$fieldset->getName()] = $translate($fieldset->getLabel());
}
?>

<?= $this->pageTitle(sprintf($translate('Search page "%1$s" (%2$s)'), $searchConfig->name(), $searchConfig->slug()), 1, $translate('Search manager')) ?>

<?= $this->form()->openTag($form) ?>

<div id="page-actions">
    <button type="submit" class="button"><?= $translate('Save') ?></button>
</div>

<nav class="section-nav sub-section-nav">
    <?= $this->sectionNav($navTab, null, $searchConfig) ?>
</nav>

<?php $next = -1; ?>
<?php foreach ($form->getFieldsets() as $name => $fieldset): ?>
<?= $this->formCollection($fieldset->setAttributes(['id' => $name, 'class' => 'section' . (++$next ? '' : ' active'), 'aria-labelledby' => $name . '-label'])) ?>
<?php endforeach; ?>

<?php foreach ($form->getElements() as $element): ?>
<?= $this->formElement($element) ?>
<?php endforeach; ?>

<?php $this->trigger('view.edit.form.after'); ?>
<?= $this->form()->closeTag() ?>
<?php $this->trigger('view.edit.after'); ?>
